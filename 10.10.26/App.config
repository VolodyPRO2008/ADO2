<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.data>
		<DbProviderFactories>
			<add name="Microsoft Data SqlClient"
				 invariant="Microsoft.Data.SqlClient"
				 description=".NET Framework Data Provider for SQL Server"
				 type="Microsoft.Data.SqlClient.SqlClientFactory, Microsoft.Data.SqlClient" />
			<add name="Microsoft Data Sqlite"
				 invariant="Microsoft.Data.Sqlite"
				 description=".NET Framework Data Provider for SQLite"
				 type="Microsoft.Data.Sqlite.SqliteFactory, Microsoft.Data.Sqlite" />
		</DbProviderFactories>
	</system.data>
</configuration>